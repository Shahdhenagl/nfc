# Manus injects DATABASE_URL in managed development and published runtime.
DATABASE_URL=mysql://user:password@host/database

# Optional: use a long random value in production for NFC access sessions.
NFC_SESSION_SECRET=replace-with-a-long-random-secret

# Manus OAuth values are injected by the managed runtime.
# MANUS_PROJECT_ID=
# MANUS_OAUTH_PORTAL_URL=
# MANUS_OAUTH_API_URL=
